
    <!-- MODAL: PUBLICAR (Metadata) -->
    <div id="publishModal"
        class="fixed inset-0 z-[110] hidden-modal transition-all duration-300 flex items-center justify-center p-4">
        <div class="absolute inset-0 bg-black/80 backdrop-blur-sm" onclick="closeModal('publishModal')"></div>
        <div
            class="bg-white dark:bg-slate-900 w-full max-w-md rounded-2xl shadow-2xl relative z-10 overflow-hidden border dark:border-slate-700">
            
            <div class="p-6 border-b border-slate-200 dark:border-slate-700">
                <h3 class="text-xl font-bold dark:text-white">Publicar Obra</h3>
                <p class="text-sm text-slate-500">Completa los detalles de tu historia.</p>
            </div>

            <div class="p-6 space-y-4">
                <div>
                    <label class="block text-xs font-bold text-slate-500 uppercase mb-1">Título</label>
                    <input type="text" id="publishTitle" placeholder="Ej. El Caballero Oscuro"
                        class="w-full bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-lg px-3 py-2 outline-none focus:ring-2 focus:ring-primary dark:text-white">
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-bold text-slate-500 uppercase mb-1">Género</label>
                        <select id="publishGenre"
                            class="w-full bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-lg px-3 py-2 outline-none focus:ring-2 focus:ring-primary dark:text-white text-sm">
                            <option value="accion">Acción</option>
                            <option value="romance">Romance</option>
                            <option value="fantasia">Fantasía</option>
                            <option value="ficcion">Ficción</option>
                            <option value="terror">Terror</option>
                            <option value="sincensura">Sin censura 🔞</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-500 uppercase mb-1">Tipo</label>
                        <select id="publishType"
                            class="w-full bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-lg px-3 py-2 outline-none focus:ring-2 focus:ring-primary dark:text-white text-sm">
                            <option value="manga">Manga</option>
                            <option value="europeo">Europeo</option>
                            <option value="western">Western</option>
                            <option value="comic">Comic</option>
                        </select>
                    </div>
                </div>

                <div class="bg-blue-50 dark:bg-blue-900/20 p-3 rounded-lg flex items-start gap-3">
                    <i data-lucide="info" class="w-5 h-5 text-blue-500 flex-shrink-0 mt-0.5"></i>
                    <p class="text-xs text-blue-700 dark:text-blue-300">
                        Se publicarán <span id="publishPageCount" class="font-bold">0</span> páginas. Asegúrate de haber guardado tus cambios.
                    </p>
                </div>
            </div>

            <div class="p-4 border-t border-slate-200 dark:border-slate-700 flex justify-end gap-3 bg-slate-50 dark:bg-slate-800/50">
                <button onclick="closeModal('publishModal')"
                    class="px-4 py-2 text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white font-medium">Volver</button>
                <button onclick="finishPublish()"
                    class="bg-primary hover:bg-primary-hover text-white px-6 py-2 rounded-lg font-bold shadow-lg shadow-orange-500/20 transition-all">
                    Publicar Ahora
                </button>
            </div>
        </div>
    </div>
